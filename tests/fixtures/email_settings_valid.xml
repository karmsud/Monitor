<Settings>
    <DisableJob>0</DisableJob>
    <Server>testserver.example.com,1433</Server>
    <Db>TestDB</Db>
    <Email>
        <SMTPServer>smtp.example.com</SMTPServer>
        <SubjectTag>Email Monitor</SubjectTag>
        <From>automation@example.com</From>
        <Support>support@example.com</Support>
    </Email>
    <Outlook>
        <Enabled>1</Enabled>
        <CredFileLocation>\\server\config\cred.xml</CredFileLocation>
        <MailboxCollection>
            <TestJob_Alpha>
                <Mailbox>frp.test@example.com</Mailbox>
                <Folder>Inbox</Folder>
                <SME>admin@example.com</SME>
                <LastEmail>2025-01-15T10:30:00</LastEmail>
                <SaveLocation>{DealFolder}\{YYYY}\{M}\incoming\</SaveLocation>
                <ServicerID>150</ServicerID>
                <Filters>
                    <From>*</From>
                    <Attachments>Y</Attachments>
                    <Subject></Subject>
                    <ImportDID>CSMC</ImportDID>
                </Filters>
                <Parsers>
                    <ConditionalParser>^RPT.+\.xlsx?$</ConditionalParser>
                </Parsers>
                <QueueOneFile>True</QueueOneFile>
                <Templates>
                    <ChecklistTemplate>CL_Standard</ChecklistTemplate>
                </Templates>
                <DayAdjust>-1</DayAdjust>
            </TestJob_Alpha>
            <TestJob_Beta>
                <Mailbox>frp.test@example.com</Mailbox>
                <Folder>Inbox</Folder>
                <SME>ops@example.com</SME>
                <SaveLocation>{DealFolder}\{YYYY}\{M}\reports\</SaveLocation>
                <ServicerID>200</ServicerID>
                <Filters>
                    <From>sender@partner.com</From>
                    <Attachments>Y</Attachments>
                    <Subject>Monthly Report</Subject>
                    <ImportDID>BETAKW</ImportDID>
                </Filters>
                <Parsers>
                    <StandardParser>\.pdf$</StandardParser>
                    <ConditionalParser>^DATA.+\.csv$</ConditionalParser>
                </Parsers>
                <Templates>
                    <ChecklistTemplate>CL_Report</ChecklistTemplate>
                    <NotificationTemplate>NT_Standard</NotificationTemplate>
                </Templates>
            </TestJob_Beta>
            <TestJob_NoServicer>
                <Mailbox>frp.shelf@example.com</Mailbox>
                <Folder>Inbox/Subfolder</Folder>
                <SME>shelf@example.com</SME>
                <SaveLocation>\\server\shelf\incoming\</SaveLocation>
                <Filters>
                    <From>*</From>
                    <Attachments>Y</Attachments>
                </Filters>
                <Parsers>
                    <StandardParser>\.xlsx?$</StandardParser>
                </Parsers>
            </TestJob_NoServicer>
        </MailboxCollection>
    </Outlook>
</Settings>
